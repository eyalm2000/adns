<?xml version="1.0" encoding="utf-8"?>
<!--
   Sign-in data is encrypted with a key that lives in the Android Keystore of this phone. It cannot
   be restored anywhere else, so it is never backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="tink_prefs_internal.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="sharedpref" path="tink_prefs_internal.xml" />
    </device-transfer>
</data-extraction-rules>